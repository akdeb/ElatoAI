# Supabase keys
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=<YOUR-SUPABASE-ANON-KEY>
JWT_SECRET_KEY=super-secret-jwt-token-with-at-least-32-characters-long

# Encryption Key (useful for encrypting secrets in the database)
ENCRYPTION_KEY=<ENCRYPTION_KEY>

# Model provider API Keys
OPENAI_API_KEY=<OPENAI_API_KEY>
GEMINI_API_KEY=<GEMINI_API_KEY>
XAI_API_KEY=<XAI_API_KEY>
ELEVENLABS_API_KEY=<ELEVENLABS_API_KEY>
HUME_API_KEY=<HUME_API_KEY>
BOSON_API_KEY=<BOSON_API_KEY>

# Optional OpenAI GPT-Live overrides (provider "openai-live")
# GPT-Live runs on the Live API, not the Realtime API, and delegates reasoning
# and tool use to a backend Responses model that must be named explicitly.
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_BACKEND_MODEL=gpt-5.6-luna
OPENAI_LIVE_VOICE=marin
# Live emits no output-audio-done event, so a spoken turn is considered over
# after this much silence. Too low clips responses (the firmware drops audio
# once it leaves SPEAKING); too high delays the device's return to listening.
OPENAI_LIVE_TURN_IDLE_MS=900

# Optional Boson Higgs Realtime overrides
BOSON_REALTIME_MODEL=higgs-realtime
BOSON_TRANSCRIPTION_MODEL=higgs-stt-3.1
BOSON_TEMPERATURE=0.3
BOSON_ESP32_VAD_THRESHOLD=0.35
BOSON_ESP32_VAD_SILENCE_MS=700

# Optional xAI Grok Voice overrides
GROK_REALTIME_MODEL=grok-voice-latest
GROK_ESP32_VAD_THRESHOLD=0.6
GROK_ESP32_VAD_PREFIX_PADDING_MS=400
GROK_ESP32_VAD_SILENCE_MS=800

# local development
HOST=0.0.0.0
PORT=8000
DEV_MODE=True
